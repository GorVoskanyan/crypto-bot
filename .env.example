# Binance API Credentials
EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_SECRET=your_binance_api_secret_here

# Trading & Environment Setup
USE_TESTNET=true
LOG_LEVEL=INFO
ENV=development

# Multi-Symbol & Dynamic Market Scanner Settings
ENABLE_SCANNER=true
TOP_SYMBOLS_COUNT=3
MIN_24H_VOLUME_USDT=10000000.0
TRADING_SYMBOL=BTC/USDT
TIMEFRAME=5m
STRATEGY=adaptive

# Risk Management & Protection Limits
RISK_PERCENT_PER_TRADE=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DAILY_DRAWDOWN_PCT=0.03
MAX_FUNDING_RATE=0.002

# Interactive Telegram Bot Notifications & Control
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
